rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Username claims. Anyone may look up one name (username sign-in needs it before signing in) but never
    // list them. The record holds the owner's id and their email locked with their password.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      // (A new account's name, or a rename: the profile then points at the new name in the same write.)
      allow create: if signedIn() && name.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/players/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.username == name);
      // Only the lock may change (re-locked after a password change), and only by its owner.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lock']);
      // Freed by its owner (a rename, or deleting the account).
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One username and gender per account, set once: the username matches the claim made in the same write.
    match /players/{uid} {
      function validGender(g) { return g == 'female' || g == 'male'; }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && validGender(request.resource.data.gender)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // Accounts made before genders existed may choose one, once. The profile picture may change any time.
      allow update: if signedIn() && request.auth.uid == uid && (
        (!('gender' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gender']) && validGender(request.resource.data.gender))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
            && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 600)))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Finding a player by email: each player writes their own address (lower case); it can be looked up one
    // address at a time, never listed.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null && request.auth.token.email.lower() == email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friends. Requests are written by whoever asks (under the other player); accepting writes both lists (the
    // other side's entry only while their request is there); either friend may end it. Invitations to a room come
    // only from friends.
    match /friends/{owner} {
      match /requests/{from} {
        // (The one who asked can read their own request: the notification sender checks it with their sign-in.)
        allow read: if signedIn() && (request.auth.uid == owner || request.auth.uid == from);
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == from);
        allow create, update: if signedIn() && request.auth.uid == from && from != owner
          && request.resource.data.from == from && !exists(/databases/$(database)/documents/friends/$(owner)/list/$(from));
      }
      match /list/{other} {
        allow read: if signedIn() && (request.auth.uid == owner || request.auth.uid == other);
        allow create, update: if signedIn() && (
          (request.auth.uid == owner && exists(/databases/$(database)/documents/friends/$(owner)/requests/$(other)))
          || (request.auth.uid == other && exists(/databases/$(database)/documents/friends/$(other)/requests/$(owner))));
        // (A friend keeps their own name and picture up to date in your list.)
        allow update: if signedIn() && request.auth.uid == other
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo']);
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == other);
      }
      // Requests this player has sent and that are still waiting (shown as "request sent"); the other player clears
      // it when they accept or discard it.
      match /sent/{to} {
        allow read, create, update: if signedIn() && request.auth.uid == owner;
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == to);
      }
      match /invites/{code} {
        allow read: if signedIn() && (request.auth.uid == owner || resource.data.from == request.auth.uid);
        allow delete: if signedIn() && request.auth.uid == owner;
        allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
          && exists(/databases/$(database)/documents/friends/$(owner)/list/$(request.auth.uid));
      }
    }

    // Private chats between two friends: chats/<smaller uid>_<larger uid>/messages/<id>. Only the two read them;
    // a message is written by its sender, to a friend, 1 to 65,536 characters (WhatsApp's limit), and never changed;
    // its sender may unsend (delete) it. seen/<uid>: when that player last had the chat open (for unread counts).
    match /chats/{chat}/messages/{id} {
      allow read: if signedIn() && chat.split('_').hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'text', 'at', 'fwd'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && (chat == request.auth.uid + '_' + request.resource.data.to || chat == request.resource.data.to + '_' + request.auth.uid)
        && chat.split('_')[0] < chat.split('_')[1]
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 65536
        && request.resource.data.at is number
        && (!('fwd' in request.resource.data) || request.resource.data.fwd == true)
        && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(request.resource.data.to));
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
    match /chats/{chat}/seen/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && chat.split('_').hasAny([uid])
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is number;
    }

    // Where to send a player's push notifications (one entry per device/browser): only they write them; the
    // server (Cloud Functions) reads them.
    match /pushTokens/{uid}/tokens/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Saves: only their owner reads or writes them.
    match /saves/{uid}/slots/{slot} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Multiplayer rooms: a code is taken while its document exists. Entering a room pushes back its expiry; the
    // creator may delete a room at any time, and anyone may remove one unvisited for 30 days (expired).
    // `admin`: the creator, until they discard the room; then whoever joined it next (a member). Only the admin
    // deletes the room or takes someone's access away (kick).
    function roomAdmin(code) {
      let r = get(/databases/$(database)/documents/rooms/$(code)).data;
      return r.get('admin', r.createdBy);
    }
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('admin', request.auth.uid) == request.auth.uid
        && request.resource.data.keys().hasOnly(['seed', 'createdAt', 'createdBy', 'admin', 'lastActiveAt', 'expiresAt']);
      allow update: if signedIn() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'expiresAt'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin'])
          && resource.data.get('admin', resource.data.createdBy) == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.resource.data.admin))));
      // (No expiry: a room lasts while someone has it; its admin — the last one left — deletes it.)
      allow delete: if signedIn() && resource.data.get('admin', resource.data.createdBy) == request.auth.uid;

      // What the room keeps for good (platform/roomWorld): things put down (anyone in it puts down and picks up),
      // apartment kitchens (anyone may change one — guests cook there too), and each player's home (their own).
      match /ground/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == request.auth.uid
          && request.resource.data.kind is string && request.resource.data.kind.size() < 40
          && request.resource.data.x is number && request.resource.data.z is number
          && (!('contents' in request.resource.data) || request.resource.data.contents.size() <= 40);
        allow delete: if signedIn();
      }
      match /apts/{key} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['key', 'n', 'j'])
          && request.resource.data.j is string && request.resource.data.j.size() < 20000 && request.resource.data.n is number;
        allow delete: if signedIn() && (roomAdmin(code) == request.auth.uid || !exists(/databases/$(database)/documents/rooms/$(code)));
      }
      match /homes/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow delete: if signedIn() && (uid == request.auth.uid || roomAdmin(code) == request.auth.uid || !exists(/databases/$(database)/documents/rooms/$(code)));
      }
      // Who has the room (saved it by joining): themselves in, themselves out (discard), or out by the admin (kick).
      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.keys().hasOnly(['name', 'photo', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 600))
          && request.resource.data.joinedAt is number;
        allow delete: if signedIn() && (uid == request.auth.uid
          || !exists(/databases/$(database)/documents/rooms/$(code))
          || roomAdmin(code) == request.auth.uid);
      }
    }
  }
}
