rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Username claims. Anyone may look up one name (username sign-in needs it before signing in) but never
    // list them. The record holds the owner's id and their email locked with their password.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && name.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/players/$(request.auth.uid));
      // Only the lock may change (re-locked after a password change), and only by its owner.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lock']);
      allow delete: if false;
    }

    // One username and gender per account, set once: the username matches the claim made in the same write.
    match /players/{uid} {
      function validGender(g) { return g == 'female' || g == 'male'; }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && validGender(request.resource.data.gender)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // Accounts made before genders existed may choose one, once. The profile picture may change any time.
      allow update: if signedIn() && request.auth.uid == uid && (
        (!('gender' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gender']) && validGender(request.resource.data.gender))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
            && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 600))));
      allow delete: if false;
    }

    // Finding a player by email: each player writes their own address (lower case); it can be looked up one
    // address at a time, never listed.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null && request.auth.token.email.lower() == email;
      allow delete: if false;
    }

    // Friends. Requests are written by whoever asks (under the other player); accepting writes both lists (the
    // other side's entry only while their request is there); either friend may end it. Invitations to a room come
    // only from friends.
    match /friends/{owner} {
      match /requests/{from} {
        // (The one who asked can read their own request: the notification sender checks it with their sign-in.)
        allow read: if signedIn() && (request.auth.uid == owner || request.auth.uid == from);
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == from);
        allow create, update: if signedIn() && request.auth.uid == from && from != owner
          && request.resource.data.from == from && !exists(/databases/$(database)/documents/friends/$(owner)/list/$(from));
      }
      match /list/{other} {
        allow read: if signedIn() && (request.auth.uid == owner || request.auth.uid == other);
        allow create, update: if signedIn() && (
          (request.auth.uid == owner && exists(/databases/$(database)/documents/friends/$(owner)/requests/$(other)))
          || (request.auth.uid == other && exists(/databases/$(database)/documents/friends/$(other)/requests/$(owner))));
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == other);
      }
      // Requests this player has sent and that are still waiting (shown as "request sent"); the other player clears
      // it when they accept or discard it.
      match /sent/{to} {
        allow read, create, update: if signedIn() && request.auth.uid == owner;
        allow delete: if signedIn() && (request.auth.uid == owner || request.auth.uid == to);
      }
      match /invites/{code} {
        allow read: if signedIn() && (request.auth.uid == owner || resource.data.from == request.auth.uid);
        allow delete: if signedIn() && request.auth.uid == owner;
        allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
          && exists(/databases/$(database)/documents/friends/$(owner)/list/$(request.auth.uid));
      }
    }

    // Where to send a player's push notifications (one entry per device/browser): only they write them; the
    // server (Cloud Functions) reads them.
    match /pushTokens/{uid}/tokens/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Saves: only their owner reads or writes them.
    match /saves/{uid}/slots/{slot} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Multiplayer rooms: a code is taken while its document exists. Entering a room pushes back its expiry; the
    // creator may delete a room at any time, and anyone may remove one unvisited for 30 days (expired).
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['seed', 'createdAt', 'createdBy', 'lastActiveAt', 'expiresAt']);
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'expiresAt']);
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || resource.data.expiresAt <= request.time);
    }
  }
}
