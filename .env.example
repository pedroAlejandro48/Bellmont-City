# Firebase web app settings (Firebase console → Project settings → General → Your apps → SDK setup and
# configuration). They identify the project and ship to every player's browser; the security rules in
# firestore.rules and database.rules.json are what protect the data.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# Only if your Realtime Database is not in us-central1 (copy its URL from the Realtime Database page):
VITE_FIREBASE_DATABASE_URL=
